{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caplock.dev/schemas/ir.schema.json",
  "title": "Caplock Policy IR",
  "description": "Normalized Policy IR v1 consumed by the evaluator, linter, report, and export backends.",
  "type": "object",
  "additionalProperties": false,
  "required": ["irVersion", "policy", "defaults", "subjects", "rules"],
  "properties": {
    "irVersion": {"const": 1},
    "policy": {"type": "string", "minLength": 1},
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect"],
      "properties": {
        "effect": {"$ref": "#/$defs/effect"}
      }
    },
    "subjects": {
      "type": "array",
      "items": {"$ref": "#/$defs/subject"}
    },
    "rules": {
      "type": "array",
      "items": {"$ref": "#/$defs/rule"}
    }
  },
  "$defs": {
    "effect": {
      "type": "string",
      "enum": ["allow", "deny", "require_approval"]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "parent": {"type": "string", "minLength": 1},
        "delegation": {"type": "string", "enum": ["attenuate-only"]}
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "effect", "match", "source"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "effect": {"$ref": "#/$defs/effect"},
        "priority": {"type": "integer", "minimum": 0},
        "match": {"$ref": "#/$defs/match"},
        "obligations": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/obligation"}
        },
        "source": {"$ref": "#/$defs/source"}
      }
    },
    "obligation": {
      "type": "string",
      "enum": ["audit", "alert", "redact", "human_approval", "rate_limit"]
    },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "subject": {"type": "string", "minLength": 1},
        "tool": {"$ref": "#/$defs/stringArray"},
        "capability": {"$ref": "#/$defs/stringArray"},
        "dataClass": {"$ref": "#/$defs/stringArray"},
        "sink": {"type": "string", "minLength": 1},
        "args": {"type": "object"},
        "context": {"$ref": "#/$defs/context"},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "time": {
          "type": "object",
          "additionalProperties": false,
          "required": ["outside"],
          "properties": {
            "outside": {"type": "string", "minLength": 1}
          }
        },
        "environment": {"type": "string", "minLength": 1},
        "attributes": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contains"],
      "properties": {
        "contains": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"$ref": "#/$defs/stringArray"}
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "line"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "line": {"type": "integer", "minimum": 1},
        "column": {"type": "integer", "minimum": 1}
      }
    }
  }
}
