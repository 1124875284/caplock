{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caplock.dev/schemas/caplock.lock.schema.json",
  "title": "Caplock lockfile",
  "description": "Deterministic lockfile for MCP server definitions and optional captured tool manifests.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "servers"],
  "properties": {
    "version": {
      "const": 1
    },
    "servers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "source",
          "transport",
          "command",
          "args",
          "url",
          "envKeys",
          "headerKeys",
          "configHash"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "transport": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": ["string", "null"]
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "url": {
            "type": ["string", "null"]
          },
          "envKeys": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "headerKeys": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "configHash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "tools": {
            "type": "array",
            "description": "Optional tool manifest captured from MCP tools/list. Static scans omit this field.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "descriptionHash", "inputSchemaHash", "capabilities"],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "descriptionHash": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "inputSchemaHash": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "annotations": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "readOnlyHint": {"type": "boolean"},
                    "destructiveHint": {"type": "boolean"},
                    "idempotentHint": {"type": "boolean"},
                    "openWorldHint": {"type": "boolean"}
                  }
                },
                "capabilities": {
                  "type": "array",
                  "items": {"type": "string", "minLength": 1},
                  "uniqueItems": true
                }
              }
            }
          }
        }
      }
    }
  }
}
