{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caplock.dev/schemas/evidence.schema.json",
  "title": "Caplock evidence corpus",
  "description": "Strict, deterministic attack-path and authorization regression corpus.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "cases"],
  "properties": {
    "version": {"const": 1},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "pathStep": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": {"type": "string"},
        "capabilities": {"$ref": "#/$defs/stringArray"},
        "sink": {"type": "string"},
        "note": {"type": "string"}
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "time": {"type": "string", "format": "date-time"},
        "environment": {"type": "string"},
        "attributes": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "tool"],
      "properties": {
        "subject": {"type": "string", "minLength": 1},
        "tool": {"type": "string", "minLength": 1},
        "capabilities": {"$ref": "#/$defs/stringArray"},
        "dataClass": {"$ref": "#/$defs/stringArray"},
        "sink": {"type": "string"},
        "args": {"type": "object"},
        "context": {"$ref": "#/$defs/context"},
        "provenance": {"$ref": "#/$defs/stringArray"}
      }
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect"],
      "properties": {
        "effect": {"enum": ["allow", "deny", "require_approval"]},
        "rule": {"type": "string"},
        "default": {"type": "boolean"},
        "obligations": {
          "type": "array",
          "items": {"enum": ["audit", "alert", "redact", "human_approval", "rate_limit"]},
          "uniqueItems": true
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "request", "expect"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "tags": {"$ref": "#/$defs/stringArray"},
        "severity": {"enum": ["info", "low", "medium", "high", "critical"]},
        "path": {
          "type": "array",
          "items": {"$ref": "#/$defs/pathStep"}
        },
        "request": {"$ref": "#/$defs/request"},
        "expect": {"$ref": "#/$defs/expect"}
      }
    }
  }
}
